# LiveKit local development credentials.
# LiveKit Cloud injects LIVEKIT_* automatically for deployed agents.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq
GROQ_API_KEY=

# Access control: comma-separated LiveKit participant identities allowed to use Velts-Bad.
# The list is deny-by-default. Example: velts,joao,maria
VELTS_BAD_ALLOWED_IDENTITIES=

# Runtime models
VELTS_BAD_LLM_MODEL=openai/gpt-oss-20b
VELTS_BAD_STT_MODEL=whisper-large-v3-turbo
VELTS_BAD_STT_LANGUAGE=pt
VELTS_BAD_TTS_MODEL=rime/coda
VELTS_BAD_TTS_VOICE=estela
VELTS_BAD_TTS_LANGUAGE=pt

# Abuse/cost controls. Values are clamped again by the application.
VELTS_BAD_PARTICIPANT_WAIT_SECONDS=45
VELTS_BAD_MAX_SESSION_SECONDS=1200
VELTS_BAD_MAX_TURN_WORDS=120
VELTS_BAD_MAX_TURN_SECONDS=45
VELTS_BAD_MAX_COMPLETION_TOKENS=256
