# LiveKit local development credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq
GROQ_API_KEY=

# Access control: comma-separated identities allowed to use Velts-Bad.
# Example: welly,joao,maria
VELTS_BAD_ALLOWED_IDENTITIES=

# Optional runtime tuning
VELTS_BAD_LLM_MODEL=llama-3.3-70b-versatile
VELTS_BAD_STT_MODEL=whisper-large-v3-turbo
VELTS_BAD_TTS_MODEL=cartesia/sonic-3.5
VELTS_BAD_TTS_LANGUAGE=pt
