# LiveKit local development credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq
GROQ_API_KEY=

# Access control: comma-separated identities allowed to use Velts-Bad.
# Example: welly,joao,maria
VELTS_BAD_ALLOWED_IDENTITIES=

# Allow LiveKit Agent Console rooms (console-*) during testing.
# Disable this before exposing a general-purpose token issuer.
VELTS_BAD_ALLOW_CONSOLE=true

# Optional runtime tuning
VELTS_BAD_LLM_MODEL=openai/gpt-oss-20b
VELTS_BAD_STT_MODEL=whisper-large-v3-turbo
VELTS_BAD_STT_LANGUAGE=pt
VELTS_BAD_TTS_MODEL=rime/coda
VELTS_BAD_TTS_VOICE=estela
VELTS_BAD_TTS_LANGUAGE=pt
